generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "debian-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  customer
  content_editor
  admin
}

model User {
  id                 String   @id @default(uuid())
  email              String   @unique
  passwordHash       String   @map("password_hash")
  displayName        String?  @map("display_name")
  phone              String?
  role               Role     @default(customer)
  mustChangePassword Boolean  @default(false) @map("must_change_password")
  createdAt          DateTime @default(now()) @map("created_at")

  vocabWords              VocabWord[]
  examQuestions           ExamQuestion[]
  quizzes                 Quiz[]
  ownedBanks              Bank[]               @relation("BankOwner")
  entitlements            Entitlement[]
  editableBanks           BankEditor[]
  grantedEntitlements     Entitlement[]        @relation("GrantedBy")
  bookEntitlements        BookEntitlement[]
  grantedBookEntitlements BookEntitlement[]    @relation("BookGrantedBy")
  invitationTokens        InvitationToken[]
  passwordResetTokens     PasswordResetToken[]
  reviewedBookPhrases     BookPhrase[]         @relation("BookPhraseReviewer")

  @@map("users")
}

model InvitationToken {
  id        String    @id @default(uuid())
  userId    String    @map("user_id")
  tokenHash String    @unique @map("token_hash")
  expiresAt DateTime  @map("expires_at")
  usedAt    DateTime? @map("used_at")
  createdAt DateTime  @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@map("invitation_tokens")
}

model PasswordResetToken {
  id        String    @id @default(uuid())
  userId    String    @map("user_id")
  tokenHash String    @unique @map("token_hash")
  expiresAt DateTime  @map("expires_at")
  usedAt    DateTime? @map("used_at")
  createdAt DateTime  @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@map("password_reset_tokens")
}

enum BankKind {
  exam
  vocab
}

enum ExamCategory {
  IQ
  Grade5Scholarship
  OL
  AL
  GovAdmin
  Other
}

model Bank {
  id                        String        @id @default(uuid())
  kind                      BankKind
  title                     String
  description               String?
  coverImageUrl             String?       @map("cover_image_url")
  examCategory              ExamCategory? @map("exam_category")
  standardExamQuestionCount Int?          @map("standard_exam_question_count")
  examTimeLimitMinutes      Int?          @map("exam_time_limit_minutes")
  theme                     String?
  price                     Decimal?      @db.Decimal(10, 2)
  isPublished               Boolean       @default(false) @map("is_published")
  isPersonal                Boolean       @default(false) @map("is_personal")
  ownerUserId               String?       @map("owner_user_id")
  owner                     User?         @relation("BankOwner", fields: [ownerUserId], references: [id], onDelete: SetNull)
  createdAt                 DateTime      @default(now()) @map("created_at")
  updatedAt                 DateTime      @updatedAt @map("updated_at")

  examQuestions ExamQuestion[]
  vocabWords    VocabWord[]
  entitlements  Entitlement[]
  editors       BankEditor[]
  quizzes       Quiz[]
  quizForBooks  Book[]

  @@index([kind, isPublished, isPersonal])
  @@map("banks")
}

model BankEditor {
  id        String   @id @default(uuid())
  userId    String   @map("user_id")
  bankId    String   @map("bank_id")
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  bank      Bank     @relation(fields: [bankId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now()) @map("created_at")

  @@unique([userId, bankId])
  @@map("bank_editors")
}

enum EntitlementSource {
  personal
  manual_grant
  promo
}

model Entitlement {
  id              String            @id @default(uuid())
  userId          String            @map("user_id")
  bankId          String            @map("bank_id")
  user            User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  bank            Bank              @relation(fields: [bankId], references: [id], onDelete: Cascade)
  source          EntitlementSource @default(manual_grant)
  grantedByUserId String?           @map("granted_by_user_id")
  grantedBy       User?             @relation("GrantedBy", fields: [grantedByUserId], references: [id], onDelete: SetNull)
  grantedAt       DateTime          @default(now()) @map("granted_at")
  expiresAt       DateTime?         @map("expires_at")

  @@unique([userId, bankId])
  @@index([userId])
  @@map("entitlements")
}

model Book {
  id                 String   @id @default(uuid())
  title              String
  author             String?
  description        String?
  coverImageUrl      String?  @map("cover_image_url")
  price              Decimal? @db.Decimal(10, 2)
  isPublished        Boolean  @default(false) @map("is_published")
  previewPhraseLimit Int      @default(5) @map("preview_phrase_limit")
  quizBankId         String?  @map("quiz_bank_id")
  quizBank           Bank?    @relation(fields: [quizBankId], references: [id], onDelete: SetNull)
  createdAt          DateTime @default(now()) @map("created_at")
  updatedAt          DateTime @updatedAt @map("updated_at")

  chapters     BookChapter[]
  entitlements BookEntitlement[]

  @@map("books")
}

model BookChapter {
  id            String   @id @default(uuid())
  bookId        String   @map("book_id")
  book          Book     @relation(fields: [bookId], references: [id], onDelete: Cascade)
  title         String
  subtitle      String?
  coverImageUrl String?  @map("cover_image_url")
  order         Int      @default(0)
  isFreePreview Boolean  @default(false) @map("is_free_preview")
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  phrases BookPhrase[]

  @@index([bookId, order])
  @@map("book_chapters")
}

model BookPhrase {
  id               String      @id @default(uuid())
  chapterId        String      @map("chapter_id")
  chapter          BookChapter @relation(fields: [chapterId], references: [id], onDelete: Cascade)
  phrase           String
  translationSi    String?     @map("translation_si")
  pronunciationSi  String?     @map("pronunciation_si")
  explanation      String
  explanationSi    String?     @map("explanation_si")
  order            Int         @default(0)
  isReviewed       Boolean     @default(false) @map("is_reviewed")
  reviewedAt       DateTime?   @map("reviewed_at")
  reviewedByUserId String?     @map("reviewed_by_user_id")
  reviewedBy       User?       @relation("BookPhraseReviewer", fields: [reviewedByUserId], references: [id], onDelete: SetNull)
  createdAt        DateTime    @default(now()) @map("created_at")
  updatedAt        DateTime    @updatedAt @map("updated_at")

  @@index([chapterId, order])
  @@index([chapterId, isReviewed])
  @@map("book_phrases")
}

model BookEntitlement {
  id              String            @id @default(uuid())
  userId          String            @map("user_id")
  bookId          String            @map("book_id")
  user            User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  book            Book              @relation(fields: [bookId], references: [id], onDelete: Cascade)
  source          EntitlementSource @default(manual_grant)
  grantedByUserId String?           @map("granted_by_user_id")
  grantedBy       User?             @relation("BookGrantedBy", fields: [grantedByUserId], references: [id], onDelete: SetNull)
  grantedAt       DateTime          @default(now()) @map("granted_at")
  expiresAt       DateTime?         @map("expires_at")

  @@unique([userId, bookId])
  @@index([userId])
  @@map("book_entitlements")
}

// Lightweight citation tag for a vocab word's source ("From: Alice in
// Wonderland") - unrelated to the sellable Book/BookChapter/BookPhrase
// product below, which owns the "Book" name since that's the more
// important, user-facing meaning going forward.
model SourceBook {
  id          String   @id @default(uuid())
  title       String
  author      String?
  description String?
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  words VocabWord[]

  @@map("source_books")
}

model VocabWord {
  id              String      @id @default(uuid())
  bankId          String      @map("bank_id")
  bank            Bank        @relation(fields: [bankId], references: [id], onDelete: Cascade)
  userId          String?     @map("user_id")
  user            User?       @relation(fields: [userId], references: [id], onDelete: SetNull)
  bookId          String?     @map("book_id")
  book            SourceBook? @relation(fields: [bookId], references: [id], onDelete: SetNull)
  chapter         String?
  term            String
  definition      String?
  definitionSi    String?     @map("definition_si")
  exampleSentence String?     @map("example_sentence")
  boxLevel        Int         @default(0) @map("box_level")
  nextReviewAt    DateTime    @default(now()) @map("next_review_at")
  timesSeen       Int         @default(0) @map("times_seen")
  timesCorrect    Int         @default(0) @map("times_correct")
  createdAt       DateTime    @default(now()) @map("created_at")
  updatedAt       DateTime    @updatedAt @map("updated_at")

  @@index([bankId, nextReviewAt])
  @@index([bookId])
  @@map("vocab_words")
}

enum QuestionLanguage {
  en
  si
}

model ExamQuestion {
  id                  String           @id @default(uuid())
  bankId              String           @map("bank_id")
  bank                Bank             @relation(fields: [bankId], references: [id], onDelete: Cascade)
  userId              String?          @map("user_id")
  user                User?            @relation(fields: [userId], references: [id], onDelete: SetNull)
  questionText        String           @map("question_text")
  answerText          String           @map("answer_text")
  correctOptionLabel  String?          @map("correct_option_label")
  explanationVideoUrl String?          @map("explanation_video_url")
  language            QuestionLanguage @default(en)
  category            String?
  boxLevel            Int              @default(0) @map("box_level")
  nextReviewAt        DateTime         @default(now()) @map("next_review_at")
  timesSeen           Int              @default(0) @map("times_seen")
  timesCorrect        Int              @default(0) @map("times_correct")
  source              String?
  createdAt           DateTime         @default(now()) @map("created_at")
  updatedAt           DateTime         @updatedAt @map("updated_at")

  images  QuestionImage[]
  options ExamQuestionOption[]

  @@index([bankId, nextReviewAt])
  @@map("exam_questions")
}

model ExamQuestionOption {
  id             String       @id @default(uuid())
  examQuestionId String       @map("exam_question_id")
  examQuestion   ExamQuestion @relation(fields: [examQuestionId], references: [id], onDelete: Cascade)
  label          String
  text           String
  isCorrect      Boolean      @default(false) @map("is_correct")
  order          Int          @default(0)

  @@index([examQuestionId])
  @@map("exam_question_options")
}

enum QuestionImageRole {
  question
  option
  answer
}

model QuestionImage {
  id             String            @id @default(uuid())
  examQuestionId String            @map("exam_question_id")
  examQuestion   ExamQuestion      @relation(fields: [examQuestionId], references: [id], onDelete: Cascade)
  role           QuestionImageRole @default(question)
  label          String?
  imagePath      String            @map("image_path")
  order          Int               @default(0)
  createdAt      DateTime          @default(now()) @map("created_at")

  @@index([examQuestionId])
  @@map("question_images")
}

enum QuizType {
  vocab
  exam
}

enum QuizMode {
  multiple_choice
  self_graded
}

enum QuizSessionMode {
  practice
  exam
}

model Quiz {
  id               String          @id @default(uuid())
  userId           String          @map("user_id")
  user             User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  bankId           String?         @map("bank_id")
  bank             Bank?           @relation(fields: [bankId], references: [id], onDelete: SetNull)
  quizType         QuizType        @map("quiz_type")
  mode             QuizMode
  sessionMode      QuizSessionMode @default(practice) @map("session_mode")
  setIndex         Int?            @map("set_index")
  timeLimitSeconds Int?            @map("time_limit_seconds")
  startedAt        DateTime        @default(now()) @map("started_at")
  completedAt      DateTime?       @map("completed_at")
  totalQuestions   Int             @map("total_questions")
  pointsEarned     Int             @default(0) @map("points_earned")

  items QuizItem[]

  @@index([userId, startedAt])
  @@index([bankId, sessionMode, setIndex])
  @@map("quizzes")
}

enum AnswerKind {
  verified_choice
  self_assessed
}

model QuizItem {
  id             String     @id @default(uuid())
  quizId         String     @map("quiz_id")
  quiz           Quiz       @relation(fields: [quizId], references: [id], onDelete: Cascade)
  vocabWordId    String?    @map("vocab_word_id")
  examQuestionId String?    @map("exam_question_id")
  order          Int        @default(0)
  answerKind     AnswerKind @default(self_assessed) @map("answer_kind")
  selectedAnswer String?    @map("selected_answer")
  wasCorrect     Boolean?   @map("was_correct")
  boxLevelBefore Int        @map("box_level_before")
  boxLevelAfter  Int?       @map("box_level_after")
  pointsAwarded  Int        @default(0) @map("points_awarded")
  answeredAt     DateTime?  @map("answered_at")

  @@index([quizId])
  @@map("quiz_items")
}
